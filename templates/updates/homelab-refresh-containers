#!/bin/sh
# Weekly: rebuild every site on a freshly pulled base image, so nginx and Alpine
# security fixes arrive without you doing anything. Then prove each site still
# answers, and tell you if one does not.
#
# The tunnel (cloudflared) is pinned to an exact version on purpose and is NOT
# bumped here. This only tells you when a newer release exists; you bump the
# tag in /srv/cloudflared/<site>/docker-compose.yml when you choose to.
set -u

rc=0
for dir in /srv/sites/*/; do
  [ -f "$dir/docker-compose.yml" ] || continue
  name=$(basename "$dir")
  port=$(sed -n 's/.*127\.0\.0\.1:\([0-9]*\):80.*/\1/p' "$dir/docker-compose.yml" | head -n 1)
  # Keep the build id the deploy baked in, so "which build is live" stays true.
  build_id=$(git -C "$dir" rev-parse --short=12 HEAD 2>/dev/null || echo dev)
  if ! (cd "$dir" && BUILD_ID="$build_id" docker compose build --pull -q && BUILD_ID="$build_id" docker compose up -d); then
    /usr/local/sbin/homelab-notify "weekly rebuild FAILED for $name; the previous container is still running"
    rc=1; continue
  fi
  sleep 5
  code=$(curl -s -o /dev/null -w '%{http_code}' --max-time 10 "http://127.0.0.1:${port:-0}/healthz")
  if [ "$code" != "200" ]; then
    /usr/local/sbin/homelab-notify "after weekly rebuild $name answers $code on /healthz"
    rc=1
  else
    logger -t homelab-refresh "$name rebuilt and healthy"
  fi
done

docker image prune -f --filter until=720h >/dev/null 2>&1 || true

latest=$(curl -fsS --max-time 15 https://api.github.com/repos/cloudflare/cloudflared/releases/latest \
  | sed -n 's/.*"tag_name": *"\([^"]*\)".*/\1/p')
for f in /srv/cloudflared/*/docker-compose.yml; do
  [ -f "$f" ] || continue
  pinned=$(sed -n 's/.*cloudflare\/cloudflared:\([^ "]*\).*/\1/p' "$f" | head -n 1)
  if [ -n "$latest" ] && [ -n "$pinned" ] && [ "$pinned" != "$latest" ]; then
    /usr/local/sbin/homelab-notify "cloudflared $latest is out; $(dirname "$f") pins $pinned"
  fi
done
exit "$rc"
