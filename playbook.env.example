# Copy to playbook.env (gitignored) and fill in. Every script reads this file.
# Nothing in here is a secret. Tokens live in their own mode-600 files, listed
# at the bottom, and never in this file.

# ── Your server ──────────────────────────────────────────────────────────────
# How your laptop reaches the server. An IP on your LAN, or a Host alias from
# ~/.ssh/config (recommended: then port and key live in one place).
SERVER_HOST=192.0.2.10
# The everyday admin account the bootstrap creates. Not root.
ADMIN_USER=admin
# The public key that account will accept. The private half never leaves your laptop.
SSH_PUBKEY_FILE=~/.ssh/id_ed25519.pub
# SSH port. Changing it cuts log noise, not risk; key-only auth is the real control.
SSH_PORT=22
# Optional: only accept SSH from this network (your home LAN), e.g. 192.168.1.0/24.
# Check YOUR laptop's address first; the firewall script refuses a value that
# would cut off the session you're running it from. Empty = SSH from anywhere,
# rate limited, which is fine behind a home router that forwards nothing.
LAN_CIDR=
TIMEZONE=America/New_York

# ── Automatic updates ────────────────────────────────────────────────────────
# Security patches install daily. If one needs a reboot, the server reboots at
# this local time, and only then.
REBOOT_TIME=04:30

# ── Your site ────────────────────────────────────────────────────────────────
# Short name, lowercase, no spaces. Used for directories and container names.
SITE_NAME=mysite
# How the site names itself in the header and title, and its one-line summary.
# Any characters are fine here (they're written into JSON, not code).
SITE_TITLE="My Site"
SITE_DESCRIPTION="What this site is, in one sentence."
# The domain you registered (Phase 3). The apex; www is added automatically.
DOMAIN=example.com
# Where your site's source lives on your LAPTOP (made by scripts/local/new-site.sh).
SITE_DIR=~/sites/mysite
# Where the site's git repo lives. The server pulls from here on every deploy.
SITE_REPO=https://github.com/you/mysite.git
# The port nginx listens on, bound to 127.0.0.1 only. Nothing outside the
# server can reach it; only the tunnel can.
SITE_PORT=8080
# A phrase that appears on your home page and nowhere else. The verifier checks
# the live page for it, because a 200 alone can be an error page. Letters,
# digits, spaces and . , ! ? - only: HTML escaping would change anything else.
SITE_MARKER="Hello from mysite"

# ── Cloudflare ───────────────────────────────────────────────────────────────
# Dashboard > any page > the account ID in the right sidebar. Not a secret.
CF_ACCOUNT_ID=

# ── Secrets: files, never this file ──────────────────────────────────────────
#   ~/.config/homelab-playbook/cloudflare.token   laptop, mode 600, API token
#   /srv/cloudflared/<SITE_NAME>/.env             server, mode 600, tunnel token
#   /etc/homelab-playbook/notify.env              server, mode 600, webhook URL
