---
import site from '../site.json';
import { scriptJson } from '../lib/json-ld.js';
import '../styles/theme.css';
import '../styles/base.css';

interface Props {
  title: string;
  description?: string;
  /** Share picture: a path on this site (/images/card.png) or an https:// URL. */
  image?: string;
  imageAlt?: string;
  /** 'article' on blog posts, 'website' everywhere else. */
  type?: 'website' | 'article';
  published?: Date;
  /** Keep this page out of search results (the 404 page). */
  noindex?: boolean;
  /** Extra JSON-LD objects for this page; a blog post adds its BlogPosting. */
  jsonLd?: Record<string, unknown>[];
}
const {
  title,
  description = site.description,
  image = site.image,
  imageAlt,
  type = 'website',
  published,
  noindex = false,
  jsonLd = [],
} = Astro.props;
// Baked in at build time by deploy.sh / the Dockerfile. The deploy verifies the
// LIVE page carries this exact value, which proves the new build is the one
// being served (and not an old one cached somewhere).
const buildId = import.meta.env.PUBLIC_BUILD_ID ?? 'dev';
const canonical = new URL(Astro.url.pathname, Astro.site);
const imageUrl = image ? new URL(image, Astro.site).href : undefined;
const nav: { label: string; href: string; button?: boolean }[] = site.nav ?? [];
const here = Astro.url.pathname;

const website = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: site.title,
  url: new URL('/', Astro.site).href,
  description: site.description,
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {site.author && <meta name="author" content={site.author} />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.title} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {imageUrl && <meta property="og:image" content={imageUrl} />}
    {imageUrl && imageAlt && <meta property="og:image:alt" content={imageAlt} />}
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    <meta name="twitter:card" content={imageUrl ? 'summary_large_image' : 'summary'} />
    {imageUrl && <meta name="twitter:image" content={imageUrl} />}
    {imageUrl && imageAlt && <meta name="twitter:image:alt" content={imageAlt} />}
    {[website, ...jsonLd].map((o) => <script type="application/ld+json" is:inline set:html={scriptJson(o)} />)}
    <meta name="build" content={`build:${buildId}`} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap row">
        <a class="brand" href="/">{site.title}</a>
        <nav aria-label="Main">
          {nav.map((item) => (
            <a
              href={item.href}
              class={item.button ? 'button button-small' : undefined}
              aria-current={item.href === here ? 'page' : undefined}
            >{item.label}</a>
          ))}
        </nav>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap row">
        <span>© {new Date().getFullYear()} {site.title}</span>
        <span class="muted">Self-hosted. Served from a server at home, through a Cloudflare tunnel.</span>
      </div>
    </footer>
  </body>
</html>
