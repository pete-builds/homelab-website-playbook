{
  "permissions": {
    "allow": [
      "Bash(./playbook)",
      "Bash(./playbook status)",
      "Bash(./playbook status *)",
      "Bash(./playbook why)",
      "Bash(./playbook why *)",
      "Bash(./playbook guide *)",
      "Bash(./playbook doctor)",
      "Bash(./playbook verify)",
      "Bash(./playbook logs)",
      "Bash(./playbook help)",
      "Bash(./scripts/verify-site.sh *)"
    ],
    "ask": [
      "mcp__cloudflare-api__execute",
      "mcp__plugin_cloudflare_cloudflare__execute",
      "Bash(*cf-domain.py register*)",
      "Bash(*playbook domain register*)",
      "Bash(script *)",
      "Bash(*expect *)"
    ],
    "deny": [
      "Read(~/.config/homelab-playbook/**)",
      "Read(//srv/cloudflared/**)",
      "Read(//etc/homelab-playbook/**)",
      "Read(**/.env)",
      "Read(**/*.token)",
      "Read(**/notify.env)",
      "Bash(*cat *homelab-playbook/*)",
      "Bash(*cat */srv/cloudflared/*)",
      "Bash(*cat *notify.env*)",
      "Bash(*cat *.token*)",
      "Bash(*head *homelab-playbook/*)",
      "Bash(*head */srv/cloudflared/*)",
      "Bash(*head *notify.env*)",
      "Bash(*head *.token*)",
      "Bash(*tail *homelab-playbook/*)",
      "Bash(*tail */srv/cloudflared/*)",
      "Bash(*tail *notify.env*)",
      "Bash(*tail *.token*)",
      "Bash(*less *homelab-playbook/*)",
      "Bash(*less */srv/cloudflared/*)",
      "Bash(*less *notify.env*)",
      "Bash(*less *.token*)",
      "Bash(*more *homelab-playbook/*)",
      "Bash(*more */srv/cloudflared/*)",
      "Bash(*more *notify.env*)",
      "Bash(*more *.token*)",
      "Bash(*grep *homelab-playbook/*)",
      "Bash(*grep */srv/cloudflared/*)",
      "Bash(*grep *notify.env*)",
      "Bash(*grep *.token*)",
      "Bash(*strings *homelab-playbook/*)",
      "Bash(*strings */srv/cloudflared/*)",
      "Bash(*strings *notify.env*)",
      "Bash(*strings *.token*)",
      "Bash(*xxd *homelab-playbook/*)",
      "Bash(*xxd */srv/cloudflared/*)",
      "Bash(*xxd *notify.env*)",
      "Bash(*xxd *.token*)",
      "Bash(*base64 *homelab-playbook/*)",
      "Bash(*base64 */srv/cloudflared/*)",
      "Bash(*base64 *notify.env*)",
      "Bash(*base64 *.token*)",
      "Bash(*sed *homelab-playbook/*)",
      "Bash(*sed */srv/cloudflared/*)",
      "Bash(*sed *notify.env*)",
      "Bash(*sed *.token*)",
      "Bash(*awk *homelab-playbook/*)",
      "Bash(*awk */srv/cloudflared/*)",
      "Bash(*awk *notify.env*)",
      "Bash(*awk *.token*)"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "python3 .claude/statusline.py",
    "padding": 0
  }
}
